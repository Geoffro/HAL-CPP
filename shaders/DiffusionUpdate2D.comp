#version 450

// PDEGrid2D::Update() for the diffusion field: commits the accumulated
// deltas into the field and clears them, so DiffusionKernel2D::RunSteps can
// chain steps in one submission. Shares Diffusion2D.comp's push constants
// (only the dimensions are read).

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer FieldBuffer
{
    float field[];
};

layout(std430, binding = 1) buffer DeltaBuffer
{
    float deltas[];
};

layout(push_constant) uniform PushConstants
{
    float diffRate;
    int   xDim;
    int   yDim;
    int   wrapX;
    int   wrapY;
}
pc;

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= (pc.xDim * pc.yDim))
    {
        return;
    }
    field[i] += deltas[i];
    deltas[i] = 0.0;
}
