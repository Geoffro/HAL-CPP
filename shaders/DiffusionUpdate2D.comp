#version 450

// The GPU-resident equivalent of PDEGrid2D::Update() for the diffusion
// field: commit the accumulated deltas into the field and clear them.
// This is what lets DiffusionKernel2D::RunSteps chain N diffusion steps
// inside one command buffer with no host round-trips between steps —
// the "pipelining" answer for dependent-step compute (see the kernel's
// header comment).
//
// Shares Diffusion2D.comp's push-constant block (same pipeline layout;
// only the dimensions are read here).

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer FieldBuffer
{
    float field[];
};

layout(std430, binding = 1) buffer DeltaBuffer
{
    float deltas[];
};

layout(push_constant) uniform PushConstants
{
    float diffRate;
    int   xDim;
    int   yDim;
    int   wrapX;
    int   wrapY;
}
pc;

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= (pc.xDim * pc.yDim))
    {
        return;
    }
    field[i] += deltas[i];
    deltas[i] = 0.0;
}
