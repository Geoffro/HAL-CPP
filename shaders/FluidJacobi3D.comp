#version 450

// Stable-fluids pressure: one Jacobi iteration of lap(p) = div.
// FluidKernel3D runs an even number per step, warm-started from the
// previous step's pressure. Clamped neighbor reads give the closed box's
// Neumann boundary.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) readonly buffer PressureIn
{
    float pIn[];
};

layout(std430, binding = 1) buffer PressureOut
{
    float pOut[];
};

layout(std430, binding = 2) readonly buffer DivergenceIn
{
    float divIn[];
};

layout(push_constant) uniform PushConstants
{
    int xDim;
    int yDim;
    int zDim;
}
pc;

int ClampIndex(int v, int dim)
{
    return clamp(v, 0, dim - 1);
}

int Flatten(int x, int y, int z)
{
    return (x * pc.yDim + y) * pc.zDim + z;
}

void main()
{
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int z = int(gl_GlobalInvocationID.z);
    if ((x >= pc.xDim) || (y >= pc.yDim) || (z >= pc.zDim))
    {
        return;
    }

    float neighbors =
        pIn[Flatten(ClampIndex(x - 1, pc.xDim), y, z)] +
        pIn[Flatten(ClampIndex(x + 1, pc.xDim), y, z)] +
        pIn[Flatten(x, ClampIndex(y - 1, pc.yDim), z)] +
        pIn[Flatten(x, ClampIndex(y + 1, pc.yDim), z)] +
        pIn[Flatten(x, y, ClampIndex(z - 1, pc.zDim))] +
        pIn[Flatten(x, y, ClampIndex(z + 1, pc.zDim))];

    int idx = Flatten(x, y, z);
    pOut[idx] = (neighbors - divIn[idx]) / 6.0;
}
