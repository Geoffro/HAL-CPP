#version 450

// GPU-resident 2D wave equation (leapfrog / Verlet time integration) — the
// hyperbolic counterpart to the parabolic diffusion kernels. Where
// diffusion smooths and dissipates, this propagates and interferes: it is
// the "ripple tank" behind examples/GpuWaveField.cpp.
//
// Discretizing u_tt = c^2 * laplacian(u) with a centered second time
// difference gives the explicit leapfrog update
//   u_next = 2*u_cur - u_prev + speed2 * laplacian(u_cur)
// where speed2 = (c*dt/dx)^2 (CFL-stable for speed2 <= 0.5 in 2D). A
// per-step multiplicative `damping` bleeds energy so the tank settles
// between source pulses instead of ringing forever.
//
// Ping-pong: binding 0 is the current field (read), binding 1 is the
// previous field (read) which is overwritten with u_next; the host swaps
// the roles each step by alternating descriptor sets. A 5-point Laplacian
// keeps the update compact; the grid is toroidal when wrap is set.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer CurBuffer
{
    float cur[];
};

layout(std430, binding = 1) buffer PrevBuffer
{
    float prev[];
};

layout(push_constant) uniform PushConstants
{
    float speed2;
    float damping;
    int xDim;
    int yDim;
    int wrap;
}
pc;

int WrapIndex(int v, int dim)
{
    int m = v % dim;
    return (m < 0) ? (m + dim) : m;
}

void main()
{
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if ((x >= pc.xDim) || (y >= pc.yDim))
    {
        return;
    }

    int i = x * pc.yDim + y;
    float c = cur[i];
    float lap = -4.0 * c;

    if ((x + 1) < pc.xDim)
    {
        lap += cur[(x + 1) * pc.yDim + y];
    }
    else if (pc.wrap != 0)
    {
        lap += cur[WrapIndex(x + 1, pc.xDim) * pc.yDim + y];
    }
    else
    {
        lap += c;
    }

    if ((x - 1) >= 0)
    {
        lap += cur[(x - 1) * pc.yDim + y];
    }
    else if (pc.wrap != 0)
    {
        lap += cur[WrapIndex(x - 1, pc.xDim) * pc.yDim + y];
    }
    else
    {
        lap += c;
    }

    if ((y + 1) < pc.yDim)
    {
        lap += cur[x * pc.yDim + (y + 1)];
    }
    else if (pc.wrap != 0)
    {
        lap += cur[x * pc.yDim + WrapIndex(y + 1, pc.yDim)];
    }
    else
    {
        lap += c;
    }

    if ((y - 1) >= 0)
    {
        lap += cur[x * pc.yDim + (y - 1)];
    }
    else if (pc.wrap != 0)
    {
        lap += cur[x * pc.yDim + WrapIndex(y - 1, pc.yDim)];
    }
    else
    {
        lap += c;
    }

    float next = (2.0 * c - prev[i] + pc.speed2 * lap) * pc.damping;
    prev[i] = next;
}
