#version 450

// Field pass of 3D Physarum, one invocation per voxel: 7-point diffusion,
// multiplicative decay, then this step's deposit (converted from the uint
// fixed-point accumulator, which is cleared). The field ping-pongs between
// two buffers.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) readonly buffer SrcBuffer
{
    float src[];
};

layout(std430, binding = 1) buffer DstBuffer
{
    float dst[];
};

layout(std430, binding = 2) buffer Deposit
{
    uint deposit[];
};

layout(push_constant) uniform PushConstants
{
    float diffuse;
    float decay;
    int xDim;
    int yDim;
    int zDim;
}
pc;

// Must match SlimeMold3DAgents.comp's deposit fixed-point scale.
const float DEPOSIT_FIXED = 256.0;

int WrapIndex(int v, int dim)
{
    int m = v % dim;
    return (m < 0) ? (m + dim) : m;
}

int Flatten(int x, int y, int z)
{
    return (x * pc.yDim + y) * pc.zDim + z;
}

void main()
{
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int z = int(gl_GlobalInvocationID.z);
    if ((x >= pc.xDim) || (y >= pc.yDim) || (z >= pc.zDim))
    {
        return;
    }

    int xm = WrapIndex(x - 1, pc.xDim);
    int xp = WrapIndex(x + 1, pc.xDim);
    int ym = WrapIndex(y - 1, pc.yDim);
    int yp = WrapIndex(y + 1, pc.yDim);
    int zm = WrapIndex(z - 1, pc.zDim);
    int zp = WrapIndex(z + 1, pc.zDim);

    int idx = Flatten(x, y, z);
    float c = src[idx];
    float neighbors = src[Flatten(xm, y, z)] + src[Flatten(xp, y, z)] + src[Flatten(x, ym, z)] + src[Flatten(x, yp, z)] + src[Flatten(x, y, zm)] + src[Flatten(x, y, zp)];
    float diffused = c + pc.diffuse * (neighbors - 6.0 * c);
    float dep = float(deposit[idx]) * (1.0 / DEPOSIT_FIXED);

    dst[idx] = max(diffused * pc.decay + dep, 0.0);
    deposit[idx] = 0u;
}
