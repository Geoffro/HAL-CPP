#version 450

// Turns per-cell agent counts into exclusive prefix-sum offsets (so cell i
// owns bucketAgents[cellOffsets[i] .. cellOffsets[i+1])), plus an initial
// copy of those offsets into a mutable cursor buffer that
// AgentScatter.comp atomically advances while placing agents.
//
// Deliberately a single-invocation sequential scan rather than a
// parallel (Hillis-Steele/Blelloch) one: cell counts are correctness-
// critical and this kernel's total work is O(numCells), which is small
// relative to the O(numAgents) cost of the surrounding passes for any
// grid actually used with agents. A parallel scan is a legitimate
// follow-up if profiling ever shows this pass matters, not a
// correctness requirement now.

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer CellCountBuffer
{
    int cellCounts[];
};

layout(std430, binding = 1) buffer CellOffsetBuffer
{
    int cellOffsets[];
};

layout(std430, binding = 2) buffer CellCursorBuffer
{
    int cellCursors[];
};

layout(push_constant) uniform PushConstants
{
    int numCells;
}
pc;

void main()
{
    int running = 0;
    for (int cell = 0; cell < pc.numCells; cell++)
    {
        cellOffsets[cell] = running;
        cellCursors[cell] = running;
        running += cellCounts[cell];
    }
    cellOffsets[pc.numCells] = running;
}
