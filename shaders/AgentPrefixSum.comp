#version 450

// Turns per-cell agent counts into exclusive prefix-sum offsets (cell i
// owns bucketAgents[cellOffsets[i] .. cellOffsets[i+1])), and copies the
// offsets into the cursor buffer AgentScatter.comp advances atomically.
//
// A single-invocation sequential scan: its O(numCells) work is small next
// to the O(numAgents) passes around it.

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer CellCountBuffer
{
    int cellCounts[];
};

layout(std430, binding = 1) buffer CellOffsetBuffer
{
    int cellOffsets[];
};

layout(std430, binding = 2) buffer CellCursorBuffer
{
    int cellCursors[];
};

layout(push_constant) uniform PushConstants
{
    int numCells;
}
pc;

void main()
{
    int running = 0;
    for (int cell = 0; cell < pc.numCells; cell++)
    {
        cellOffsets[cell] = running;
        cellCursors[cell] = running;
        running += cellCounts[cell];
    }
    cellOffsets[pc.numCells] = running;
}
